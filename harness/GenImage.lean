import RiscvZkvm.Interpreter.Elf
import RiscvZkvm.Interpreter.Decode

/-!
Emit Lean source for the contents of `build/pure.elf`:

  lake exe gen-image build/pure.elf build/symbols.txt PureInterp/Image

`symbols.txt` is produced by `tools/symbols.py` (address, size, short name). One definition group is
written per function: its address, its raw 32-bit words, the decoded
instruction list, and a kernel-checked theorem that the words decode to that
list. This generator is therefore not trusted for the instruction lists; it is
trusted only for copying bytes out of the ELF, which `Image/Check.lean`
re-checks against the file's hash at build time is future work.
-/

open RiscvZkvm.Rv64 RiscvZkvm.Interpreter

structure Sym where
  addr : Nat
  size : Nat
  name : String
  demangled : String

def parseHexNat (s : String) : Nat :=
  s.foldl (fun acc c =>
    acc * 16 + (if c.isDigit then c.toNat - 48 else c.toNat - 87)) 0

def parseSyms (txt : String) : Array Sym := Id.run do
  let mut out : Array Sym := #[]
  for line in txt.splitOn "\n" do
    match line.splitOn " " with
    | a :: s :: _ :: name :: _ :: rest =>
      out := out.push ⟨parseHexNat a, parseHexNat s, name, " ".intercalate rest⟩
    | _ => pure ()
  return out.qsort (fun x y => x.addr < y.addr)

def hex (n : Nat) (width : Nat) : String :=
  let ds := (Nat.toDigits 16 n)
  String.ofList (List.replicate (width - ds.length) '0' ++ ds)

def word32 (bs : ByteArray) (off : Nat) : Nat :=
  bs[off]!.toNat ||| (bs[off+1]!.toNat <<< 8) ||| (bs[off+2]!.toNat <<< 16) ||| (bs[off+3]!.toNat <<< 24)

def header (extra : String := "") : String :=
  "-- GENERATED by `lake exe gen-image`; do not edit.\n" ++
  "import RiscvZkvm.Rv64.Basic\nimport RiscvZkvm.Interpreter.Decode\n" ++ extra ++
  "\nset_option maxRecDepth 100000\n\nopen RiscvZkvm.Rv64 RiscvZkvm.Interpreter\n\nnamespace PureInterp.Image\n\n"

def main (args : List String) : IO UInt32 := do
  let [elf, symFile, outDir] := args
    | IO.eprintln "usage: gen-image <elf> <symbols> <out dir>"; return 2
  let img ← IO.ofExcept (parseElf64 (← IO.FS.readBinFile elf) |>.mapError IO.userError)
  let syms := parseSyms (← IO.FS.readFile symFile)
  let some text := img.segments.find? (·.executable)
    | IO.eprintln "no executable segment"; return 1
  IO.FS.createDirAll outDir
  let chunks := 12
  let mut files : Array String := Array.replicate chunks ""
  let mut index := ""
  let mut covered := 0
  let mut next := text.vaddr
  let mut k := 0
  for s in syms do
    if s.size == 0 || s.addr < text.vaddr || s.addr ≥ text.vaddr + text.data.size then continue
    if s.addr < next then continue -- alias of a function already emitted
    if s.addr ≠ next then
      IO.eprintln s!"gap in .text: {hex next 8}..{hex s.addr 8}"; return 1
    let n := s.size / 4
    let ws := (List.range n).map fun i => word32 text.data (s.addr - text.vaddr + 4 * i)
    let mut prog : List String := []
    for w in ws do
      match decode (BitVec.ofNat 32 w) with
      | some i => prog := prog ++ [toString (repr i)]
      | none => IO.eprintln s!"undecodable word {hex w 8} in {s.demangled}"; return 1
    let nm := s.name
    let src :=
      s!"/-- `{s.demangled}` -/\ndef {nm}.addr : Word := 0x{hex s.addr 8}\n\n" ++
      s!"def {nm}.words : List (BitVec 32) := [\n  " ++
        ", ".intercalate (ws.map fun w => s!"0x{hex w 8}") ++ "]\n\n" ++
      s!"def {nm}.prog : List Instr := [\n  " ++ ",\n  ".intercalate prog ++ "]\n\n" ++
      s!"theorem {nm}.decode : {nm}.words.map decode = {nm}.prog.map some := by decide\n\n"
    let c := k % chunks
    files := files.set! c (files[c]! ++ src)
    index := index ++ s!"  ({nm}.addr, {nm}.prog), -- {s.demangled}\n"
    covered := covered + n
    next := s.addr + s.size
    k := k + 1
  if next ≠ text.vaddr + text.data.size then
    IO.eprintln s!"trailing .text not covered by symbols from {hex next 8}"; return 1
  let mut imports := ""
  for c in [0:chunks] do
    IO.FS.writeFile s!"{outDir}/Text{c}.lean" (header ++ files[c]! ++ "end PureInterp.Image\n")
    imports := imports ++ s!"import PureInterp.Image.Text{c}\n"
  -- Read-only and initialised data, as bytes.
  let mut data := ""
  let mut di := 0
  for seg in img.segments do
    if seg.executable || seg.data.size == 0 then continue
    let bs := ", ".intercalate (seg.data.toList.map fun b => toString b.toNat)
    data := data ++ s!"def data{di}.addr : Word := 0x{hex seg.vaddr 8}\n\n" ++
      s!"def data{di}.bytes : List (BitVec 8) := [{bs}]\n\n"
    di := di + 1
  IO.FS.writeFile s!"{outDir}/Data.lean" (header ++ data ++ "end PureInterp.Image\n")
  IO.FS.writeFile s!"{outDir}/Index.lean"
    (header (imports ++ "import PureInterp.Image.Data\n") ++
     s!"def entry : Word := 0x{hex img.entry 8}\n\n" ++
     s!"def textBase : Word := 0x{hex text.vaddr 8}\n\n" ++
     "/-- Every function of the binary: load address and decoded instructions. -/\n" ++
     "def functions : List (Word × List Instr) := [\n" ++ index ++ "]\n\n" ++
     s!"/-- Total number of instructions ({covered}). -/\n" ++
     "def instrCount : Nat := (functions.map (·.2.length)).sum\n\n" ++
     "end PureInterp.Image\n")
  IO.println s!"{k} functions, {covered} instructions, {di} data segments"
  return 0
